# ===== McOptimum 环境变量示例 =====
# 复制为 .env.local 后填写真实值；.env.local 已被 .gitignore 排除，永远不会入库。
# ⚠️ 绝对不要把真实值写进 README / 截图 / issue / commit message。

# 麦当劳官方 MCP Server（streamable-http）
MCD_MCP_URL=https://mcp.mcd.cn

# 你的 MCP 访问令牌（Bearer）。只放在本机环境变量里。
MCD_MCP_TOKEN=replace-with-your-own-token

# 运行模式：
#   mock = 离线演示，使用 fixtures/ 中的脱敏真实快照，无需任何凭据
#   live = 直连真实麦当劳 MCP
MCD_MODE=mock

# 默认门店（可为空，为空时由 /api/optimize 的请求体指定）
MCD_DEFAULT_STORE_CODE=

# 默认配送地址 ID（外送渠道用；属个人数据，不要提交真实值）
MCD_DEFAULT_ADDRESS_ID=
